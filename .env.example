# Vercel → Project → Settings → Environment Variables
# DATABASE_URL is added automatically when you connect a Neon database (Storage tab).
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# First super admin (the chairman). Remove SUPERADMIN_INITIAL_CODE after the first sign-in.
SUPERADMIN_ID=01020003679
SUPERADMIN_INITIAL_CODE=ABCD-2345
# Optional
SESSION_HOURS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
