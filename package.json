{
  "name": "alpiki-consent",
  "version": "2.0.0",
  "private": true,
  "description": "HOA Alpiki consent registry: member sign-in, e-signatures, admin console",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "e2e": "node --disable-warning=ExperimentalWarning test/e2e/browser.mjs docs/screenshots"
  }
}
